<resources>
    <!-- Tokens de app/globals.css (color-bg-dark = #0a0a0c). Barras do sistema
         transparentes + janela edge-to-edge (ver MainActivity: modo imersivo
         real, sem Navigation Bar a aparecer como "footer"). -->
    <style name="Theme.PixGo" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorBackground">#0a0a0c</item>
        <item name="android:windowBackground">#0a0a0c</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources>
